# Allow only application code, dependency lock, and committed test fixtures.
**
!Dockerfile
!.dockerignore
!compose.yaml
!requirements-docker.txt
!dashboard.py
!pdf_export.py
!extract_documents.py
!run.py
!pytest.ini
!src/
!src/**
!demo/
!demo/**
!examples/
!examples/**
!tests/
!tests/**
!data/
!data/**
!assets/
!assets/f1040s--2025.pdf
!assets/dashboard.css
!.streamlit/
!.streamlit/config.toml

# Exclude generated files even inside the allowed source directories.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.env
**/.env.*
**/secrets.toml
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
